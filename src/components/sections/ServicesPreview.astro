---
import type { Lang } from '@i18n/languages';
import { useTranslations, getLocalizedPath } from '@i18n/index';
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '@components/ui/Button.astro';
import { services } from '@data/services';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const previewServices = services.slice(0, 6);
const base = import.meta.env.BASE_URL || '';
---

<section class="services-preview section">
  <div class="container">
    <SectionHeader
      title={t('sections.services.title') || 'خدماتنا الهندسية والتقنية'}
      description={t('sections.services.description') || 'نقدم حلولاً برمجية وهندسية شاملة تشمل برمجة المايكروكونترولر، تطوير الأنظمة الكبيرة، البرامج المجانية، وتكامل الأنظمة.'}
    />

    <div class="services-grid" data-stagger-group>
      {previewServices.map((service) => (
        <a href={`${base.replace(/\/$/, '')}${getLocalizedPath(lang, '/services/')}`} class="service-card" data-stagger-item>
          <div class="icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="32" height="32">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={service.iconPath} />
            </svg>
          </div>
          <h3 class="card-title">{t(`services.items.${service.translationKey}.title`)}</h3>
          <p class="card-desc">{t(`services.items.${service.translationKey}.description`)}</p>
          <span class="learn-more">
            {t('common.learnMore')}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </a>
      ))}
    </div>

    <div class="actions" data-animate="up">
      <Button href={`${base.replace(/\/$/, '')}${getLocalizedPath(lang, '/services/')}`} variant="outline" size="lg">
        {t('sections.services.viewAll')}
      </Button>
    </div>
  </div>
</section>

<style>
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding-inline: var(--space-6);
  }

  .services-preview {
    padding-block: var(--space-16);
    background-color: var(--color-background);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-block-end: var(--space-12);
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease, border-color 0.35s ease;
    height: 100%;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary-light), var(--color-glow));
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(59, 139, 235, 0.15), var(--shadow-md);
    border-color: var(--color-primary-light);
  }

  .service-card:hover::before {
    opacity: 1;
  }

  .icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: var(--radius-lg);
    background-color: rgba(59, 139, 235, 0.1);
    border: 1px solid rgba(59, 139, 235, 0.2);
    color: var(--color-primary-light);
    margin-block-end: var(--space-6);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .service-card:hover .icon-wrapper {
    background-color: rgba(59, 139, 235, 0.2);
    border-color: var(--color-primary-light);
  }

  .card-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin-top: 0;
    margin-block-end: var(--space-3);
  }

  .card-desc {
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    margin-block-end: var(--space-6);
    flex-grow: 1;
  }

  .learn-more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-primary-light);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-sm);
  }

  .arrow {
    transition: transform 0.2s ease;
  }

  .service-card:hover .arrow {
    transform: translateX(4px);
  }

  :global([dir="rtl"]) .service-card:hover .arrow {
    transform: translateX(-4px);
  }

  :global([dir="rtl"]) .arrow {
    transform: scaleX(-1);
  }
  
  :global([dir="rtl"]) .service-card:hover .arrow {
    transform: scaleX(-1) translateX(4px);
  }

  .actions {
    display: flex;
    justify-content: center;
  }
</style>
