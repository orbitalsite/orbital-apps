---
import type { Lang } from '@i18n/languages';
import { useTranslations } from '@i18n/index';
import SectionHeader from '@components/ui/SectionHeader.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const values = [
  {
    id: 'precision',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>`
  },
  {
    id: 'performance',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>`
  },
  {
    id: 'security',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>`
  },
  {
    id: 'innovation',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>`
  }
];
---

<section class="why-orbital section">
  <div class="container">
    <SectionHeader
      tag={t('sections.whyOrbital.tag') || 'Why Choose Us'}
      title={t('sections.whyOrbital.title') || 'The ORBITAL Advantage'}
      description={t('sections.whyOrbital.description') || 'We bring technical excellence and deep industry expertise to every project.'}
    />

    <div class="values-grid" data-stagger-group>
      {values.map((value) => (
        <div class="value-card" data-stagger-item>
          <div class="icon-box" set:html={value.icon} />
          <h3 class="value-title">{t(`sections.whyOrbital.${value.id}.title`) || value.id}</h3>
          <p class="value-desc">{t(`sections.whyOrbital.${value.id}.description`) || 'Description goes here'}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding-inline: var(--space-6);
  }

  .why-orbital {
    padding-block: var(--space-16);
    background-color: var(--color-surface);
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .value-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background-color: var(--color-background);
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease;
  }

  .value-card:hover {
    transform: translateY(-4px);
  }

  .icon-box {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    background-color: var(--color-primary-light, rgba(59, 139, 235, 0.1));
    border-radius: var(--radius-md);
  }

  .icon-box :global(svg) {
    width: 24px;
    height: 24px;
  }

  .value-title {
    font-size: var(--font-size-xl);
    color: var(--color-heading);
    margin: 0;
  }

  .value-desc {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }
</style>
