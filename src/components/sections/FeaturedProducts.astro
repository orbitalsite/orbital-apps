---
/**
 * ORBITAL — Featured Products Section
 * Shows featured products on the homepage with cards.
 */
import { useTranslations, getLocalizedPath } from '@i18n/index';
import type { Lang } from '@i18n/languages';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const allProducts = await getCollection('products');
const featured = allProducts
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<section class="section featured-products" id="featured-products">
  <div class="container">
    <div class="featured-products__header" data-animate="up">
      <span class="featured-products__tag tracking-widest">{t('sections.products.title')}</span>
      <h2 class="heading-2">{t('sections.products.title')}</h2>
      <p class="text-lg text-muted">{t('sections.products.description')}</p>
    </div>

    <div class="featured-products__grid" data-stagger-group>
      {featured.map((product) => {
        const tr = product.data.translations[lang as keyof typeof product.data.translations];
        return (
          <a 
            href={`${base.replace(/\/$/, '')}${getLocalizedPath(lang, `/programs/${product.data.slug}/`)}`}
            class="product-card"
            data-stagger-item
          >
            <div class="product-card__icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <line x1="8" y1="21" x2="16" y2="21" />
                <line x1="12" y1="17" x2="12" y2="21" />
              </svg>
            </div>
            <div class="product-card__content">
              <h3 class="product-card__name">{tr.name}</h3>
              <p class="product-card__description line-clamp-2">{tr.description}</p>
              <div class="product-card__meta">
                <span class="product-card__version text-sm text-muted">v{product.data.version}</span>
                {product.data.free && (
                  <span class="product-card__badge">{t('programs.free')}</span>
                )}
                <span class="product-card__platforms text-sm text-muted">
                  {product.data.platforms.join(' / ')}
                </span>
              </div>
            </div>
            <div class="product-card__arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </div>
          </a>
        );
      })}
    </div>

    <div class="featured-products__action" data-animate="up">
      <a href={`${base.replace(/\/$/, '')}${getLocalizedPath(lang, '/programs/')}`} class="featured-products__link">
        {t('sections.products.viewAll')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .featured-products__header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .featured-products__tag {
    display: inline-block;
    font-size: var(--font-size-xs);
    color: var(--color-primary-light);
    margin-bottom: var(--space-4);
  }

  .featured-products__header h2 {
    margin-bottom: var(--space-4);
  }

  .featured-products__header p {
    max-width: 560px;
    margin-inline: auto;
  }

  .featured-products__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  /* Product Card */
  .product-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: var(--color-text);
    transition: all var(--transition-base);
  }

  .product-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-md), var(--shadow-glow);
    transform: translateY(-2px);
  }

  .product-card__icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-primary-light);
  }

  .product-card__content {
    flex: 1;
    min-width: 0;
  }

  .product-card__name {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .product-card__description {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    line-height: var(--line-height-relaxed);
  }

  .product-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .product-card__badge {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    padding: var(--space-1) var(--space-2);
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-success);
    border-radius: var(--radius-sm);
  }

  .product-card__arrow {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: color var(--transition-fast), transform var(--transition-fast);
    margin-top: var(--space-2);
  }

  [dir="rtl"] .product-card__arrow svg {
    transform: scaleX(-1);
  }

  .product-card:hover .product-card__arrow {
    color: var(--color-primary-light);
    transform: translateX(4px);
  }

  [dir="rtl"] .product-card:hover .product-card__arrow {
    transform: translateX(-4px);
  }

  /* Action */
  .featured-products__action {
    text-align: center;
  }

  .featured-products__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary-light);
    text-decoration: none;
    transition: gap var(--transition-fast);
  }

  .featured-products__link:hover {
    gap: var(--space-3);
  }

  [dir="rtl"] .featured-products__link svg {
    transform: scaleX(-1);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .featured-products__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
