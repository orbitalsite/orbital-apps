---
/**
 * ORBITAL — Programs 3D Canvas Component
 * Lightweight, high-performance 3D geometric mesh for Programs page
 */
---

<div class="programs-3d-wrapper">
  <canvas id="programs-3d-canvas"></canvas>
</div>

<script>
  import * as THREE from 'three';

  function initPrograms3D() {
    const canvas = document.getElementById('programs-3d-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const container = canvas.parentElement;
    if (!container) return;

    let width = container.clientWidth || 300;
    let height = container.clientHeight || 220;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.z = 4.5;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height);
    renderer.setClearColor(0x000000, 0);

    // Group for 3D elements
    const meshGroup = new THREE.Group();
    scene.add(meshGroup);

    // 1. Outer Geodesic Grid
    const geoGeometry = new THREE.IcosahedronGeometry(1.5, 1);
    const geoEdges = new THREE.EdgesGeometry(geoGeometry);
    const lineMaterial = new THREE.LineBasicMaterial({
      color: 0x3B8BEB,
      transparent: true,
      opacity: 0.45,
    });
    const wireframeMesh = new THREE.LineSegments(geoEdges, lineMaterial);
    meshGroup.add(wireframeMesh);

    // 2. Vertex Points
    const pointsMaterial = new THREE.PointsMaterial({
      color: 0x4DC9F6,
      size: 0.06,
      transparent: true,
      opacity: 0.85,
    });
    const pointsMesh = new THREE.Points(geoGeometry, pointsMaterial);
    meshGroup.add(pointsMesh);

    // 3. Inner Glowing Core
    const coreGeometry = new THREE.SphereGeometry(0.65, 16, 16);
    const coreMaterial = new THREE.MeshBasicMaterial({
      color: 0xFF2A4B, // Red color as requested
      wireframe: true,
      transparent: true,
      opacity: 0.45,
    });
    const coreMesh = new THREE.Mesh(coreGeometry, coreMaterial);
    meshGroup.add(coreMesh);

    // Parallax mouse variables
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    const handleMouseMove = (e: MouseEvent) => {
      const rect = container.getBoundingClientRect();
      mouseX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouseY = -((e.clientY - rect.top) / rect.height) * 2 + 1;
    };

    window.addEventListener('mousemove', handleMouseMove, { passive: true });

    // Resize handler
    const handleResize = () => {
      width = container.clientWidth || 300;
      height = container.clientHeight || 220;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    };

    window.addEventListener('resize', handleResize, { passive: true });

    // Animation Loop
    let animId: number;
    const clock = new THREE.Clock();

    const animate = () => {
      animId = requestAnimationFrame(animate);
      const elapsedTime = clock.getElapsedTime();

      // Constant rotation
      meshGroup.rotation.y = elapsedTime * 0.4;
      meshGroup.rotation.x = elapsedTime * 0.25;

      // Smooth mouse lerp
      targetX += (mouseX * 0.5 - targetX) * 0.05;
      targetY += (mouseY * 0.5 - targetY) * 0.05;

      meshGroup.position.x = targetX * 0.6;
      meshGroup.position.y = targetY * 0.4;

      renderer.render(scene, camera);
    };

    animate();

    // Cleanup when leaving page
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animId);
      window.removeEventListener('mousemove', handleMouseMove);
      window.removeEventListener('resize', handleResize);
      renderer.dispose();
    }, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPrograms3D);
  } else {
    initPrograms3D();
  }
</script>

<style>
  .programs-3d-wrapper {
    width: 100%;
    max-width: 320px;
    height: 200px;
    margin: 0 auto var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    pointer-events: none;
  }

  #programs-3d-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
