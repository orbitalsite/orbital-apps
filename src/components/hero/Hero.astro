---
/**
 * ORBITAL — Homepage Hero Section (Premium Edition)
 * Features:
 * - Full-bleed 3D scene background
 * - Large prominent company logo
 * - Elegant gradient text and refined typography
 * - Subtle radial gradient overlay for depth
 * - GSAP staggered intro animations
 */
import { useTranslations, getLocalizedPath } from '@i18n/index';
import type { Lang } from '@i18n/languages';
import OrbitalScene from './OrbitalScene.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const programsUrl = `${base.replace(/\/$/, '')}${getLocalizedPath(lang, '/programs/')}`;
const aboutUrl = `${base.replace(/\/$/, '')}${getLocalizedPath(lang, '/about/')}`;
---

<section class="hero" id="hero">
  <!-- Full-bleed 3D Scene Layer -->
  <div class="hero__scene-layer">
    <OrbitalScene />
  </div>

  <!-- Subtle gradient overlays for depth and text readability -->
  <div class="hero__gradient-overlay"></div>

  <!-- Foreground Content Layer -->
  <div class="hero__content-layer container">
    <div class="hero__text-box">
      <!-- Large Company Logo -->
      <div class="hero__logo-block" data-hero-intro>
        <img 
          src={`${base.replace(/\/$/, '')}/images/hlogo.png`} 
          alt="ORBITAL" 
          width="300" 
          height="300"
          class="hero__logo-img"
        />
        <span class="hero__logo-text">ORBITAL</span>
      </div>

      <!-- Main Heading -->
      <h1 class="hero__title" data-hero-intro>
        {t('hero.title')}
      </h1>
      
      <!-- Decorative accent line -->
      <div class="hero__accent-line" data-hero-intro></div>

      <!-- Subtitle -->
      <p class="hero__subtitle" data-hero-intro>
        {t('hero.subtitle')}
      </p>
      
      <!-- Action Buttons -->
      <div class="hero__actions" data-hero-intro>
        <a href={programsUrl} class="hero__btn hero__btn--primary">
          <span>{t('hero.cta_programs')}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
        <a href={aboutUrl} class="hero__btn hero__btn--ghost">
          <span>{t('hero.cta_about')}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="hero__scroll" data-hero-intro>
    <span class="hero__scroll-label">Scroll</span>
    <div class="hero__scroll-line"></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initHeroAnimations() {
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const introElements = document.querySelectorAll('[data-hero-intro]');
    if (!isReduced && introElements.length > 0) {
      gsap.from(introElements, {
        opacity: 0,
        y: 40,
        duration: 1.2,
        stagger: 0.15,
        ease: 'power3.out',
        delay: 0.3,
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroAnimations);
  } else {
    initHeroAnimations();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: calc(var(--navbar-height) + var(--space-8));
    padding-bottom: var(--space-16);
    background: var(--color-background);
  }

  /* Full-bleed 3D Scene */
  .hero__scene-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* Gradient overlay for text readability */
  .hero__gradient-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  [dir="rtl"] .hero__gradient-overlay {
    background: linear-gradient(
      to left,
      rgba(10, 14, 23, 0.65) 0%,
      rgba(10, 14, 23, 0.3) 40%,
      transparent 70%
    );
  }

  [dir="ltr"] .hero__gradient-overlay {
    background: linear-gradient(
      to right,
      rgba(10, 14, 23, 0.65) 0%,
      rgba(10, 14, 23, 0.3) 40%,
      transparent 70%
    );
  }

  [data-theme="light"] [dir="rtl"] .hero__gradient-overlay {
    background: linear-gradient(
      to left,
      rgba(255, 255, 255, 0.75) 0%,
      rgba(255, 255, 255, 0.4) 40%,
      transparent 70%
    );
  }

  [data-theme="light"] [dir="ltr"] .hero__gradient-overlay {
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0.75) 0%,
      rgba(255, 255, 255, 0.4) 40%,
      transparent 70%
    );
  }

  /* Foreground Content */
  .hero__content-layer {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline: var(--space-6);
    display: flex;
    align-items: center;
  }

  [dir="rtl"] .hero__content-layer {
    justify-content: flex-start;
  }

  [dir="rtl"] .hero__text-box {
    text-align: right;
    margin-inline-start: 0;
    margin-inline-end: auto;
  }

  [dir="ltr"] .hero__content-layer {
    justify-content: flex-start;
  }

  [dir="ltr"] .hero__text-box {
    text-align: left;
    margin-inline-start: 0;
    margin-inline-end: auto;
  }

  /* Text container - seamless (no card) */
  .hero__text-box {
    max-width: 500px;
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  /* ── Logo Block ── */
  .hero__logo-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    margin-bottom: var(--space-6);
    position: relative;
  }

  .hero__logo-img {
    width: 220px;
    height: 220px;
    object-fit: contain;
    filter: drop-shadow(0 0 24px rgba(59, 139, 235, 0.45));
    transition: filter var(--transition-slow);
    margin-inline-start: 80px;
    margin-bottom: -20px;
  }

  .hero__logo-img:hover {
    filter: drop-shadow(0 0 20px rgba(77, 201, 246, 0.5));
  }

  .hero__logo-text {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: var(--letter-spacing-widest);
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-glow));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── Title ── */
  .hero__title {
    font-size: clamp(var(--font-size-2xl), 5vw, var(--font-size-4xl));
    font-weight: var(--font-weight-extrabold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
    color: var(--color-text);
    margin-bottom: var(--space-5);
  }

  /* ── Accent Line ── */
  .hero__accent-line {
    width: 56px;
    height: 3px;
    border-radius: var(--radius-full);
    background: linear-gradient(90deg, var(--color-primary-light), var(--color-glow));
    margin-bottom: var(--space-5);
    box-shadow: 0 0 12px rgba(59, 139, 235, 0.3);
  }

  [dir="rtl"] .hero__accent-line {
    margin-right: 0;
    margin-left: auto;
  }

  [dir="ltr"] .hero__accent-line {
    margin-left: 0;
    margin-right: auto;
  }

  /* ── Subtitle ── */
  .hero__subtitle {
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-8);
    max-width: 420px;
  }

  /* ── Actions ── */
  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    white-space: nowrap;
    position: relative;
    overflow: hidden;
  }

  .hero__btn--primary {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
    color: #FFFFFF;
    box-shadow: 0 4px 16px rgba(59, 139, 235, 0.3), 0 0 0 1px rgba(59, 139, 235, 0.1);
  }

  .hero__btn--primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(59, 139, 235, 0.45), 0 0 0 1px rgba(59, 139, 235, 0.2);
  }

  .hero__btn--ghost {
    color: var(--color-text);
    border: 1px solid var(--color-border);
    background: transparent;
  }

  .hero__btn--ghost:hover {
    border-color: var(--color-primary-light);
    color: var(--color-primary-light);
    background: rgba(59, 139, 235, 0.06);
    transform: translateY(-3px);
  }

  [dir="rtl"] .hero__btn svg {
    transform: scaleX(-1);
  }

  /* ── Scroll Indicator ── */
  .hero__scroll {
    position: absolute;
    bottom: var(--space-6);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    z-index: 1;
  }

  .hero__scroll-label {
    font-size: 10px;
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .hero__scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, var(--color-primary-light), transparent);
    animation: scrollPulse 2.5s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.2; height: 20px; }
    50% { opacity: 0.7; height: 38px; }
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .hero__gradient-overlay {
      background: radial-gradient(
        ellipse at center,
        rgba(10, 14, 23, 0.5) 0%,
        transparent 70%
      ) !important;
    }

    [data-theme="light"] .hero__gradient-overlay {
      background: radial-gradient(
        ellipse at center,
        rgba(255, 255, 255, 0.6) 0%,
        transparent 70%
      ) !important;
    }

    .hero__content-layer {
      justify-content: center !important;
    }

    .hero__text-box {
      text-align: center !important;
      margin-inline: auto !important;
      max-width: 520px;
    }

    .hero__logo-block {
      align-items: center;
    }

    .hero__logo-img {
      margin-inline-start: 0;
    }

    .hero__accent-line {
      margin-inline: auto !important;
    }

    .hero__subtitle {
      margin-inline: auto;
    }

    .hero__actions {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 90vh;
      padding-top: calc(var(--navbar-height) + var(--space-6));
      padding-bottom: var(--space-8);
    }

    .hero__logo-img {
      width: 160px;
      height: 160px;
      margin-bottom: -12px;
    }

    .hero__logo-text {
      font-size: var(--font-size-xl);
    }

    .hero__text-box {
      max-width: 100%;
    }

    .hero__title {
      font-size: var(--font-size-2xl);
    }

    .hero__subtitle {
      font-size: var(--font-size-base);
    }

    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero__logo-img {
      width: 120px;
      height: 120px;
      margin-bottom: -8px;
    }

    .hero__logo-text {
      font-size: var(--font-size-lg);
    }

    .hero__title {
      font-size: var(--font-size-xl);
    }

    .hero__actions {
      flex-direction: column;
      width: 100%;
    }

    .hero__btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line {
      animation: none;
      opacity: 0.4;
    }
  }
</style>
