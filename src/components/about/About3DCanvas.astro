---
/**
 * ORBITAL — About 3D Canvas Component
 * Lightweight, high-performance 3D global vision mesh for About page
 */
---

<div class="about-3d-wrapper">
  <canvas id="about-3d-canvas"></canvas>
</div>

<script>
  import * as THREE from 'three';

  function initAbout3D() {
    const canvas = document.getElementById('about-3d-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const container = canvas.parentElement;
    if (!container) return;

    let width = container.clientWidth || 320;
    let height = container.clientHeight || 220;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.z = 4.6;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height);
    renderer.setClearColor(0x000000, 0);

    // Group for 3D mesh
    const meshGroup = new THREE.Group();
    scene.add(meshGroup);

    // 1. Outer Wireframe Globe (Icosahedron)
    const globeGeometry = new THREE.IcosahedronGeometry(1.4, 2);
    const globeEdges = new THREE.EdgesGeometry(globeGeometry);
    const lineMaterial = new THREE.LineBasicMaterial({
      color: 0x3B8BEB,
      transparent: true,
      opacity: 0.45,
    });
    const wireframeMesh = new THREE.LineSegments(globeEdges, lineMaterial);
    meshGroup.add(wireframeMesh);

    // 2. Vertex Glowing Nodes
    const pointsMaterial = new THREE.PointsMaterial({
      color: 0x4DC9F6,
      size: 0.05,
      transparent: true,
      opacity: 0.85,
    });
    const pointsMesh = new THREE.Points(globeGeometry, pointsMaterial);
    meshGroup.add(pointsMesh);

    // 3. Inner Rotating Core Ring (Fiery Blazing Crimson Red)
    const ringGeometry = new THREE.TorusGeometry(0.85, 0.04, 16, 48);
    const ringMaterial = new THREE.MeshBasicMaterial({
      color: 0xFF1122, // Intense Deep Red
      wireframe: true,
      transparent: true,
      opacity: 0.9,
      blending: THREE.AdditiveBlending,
    });
    const ringMesh = new THREE.Mesh(ringGeometry, ringMaterial);
    ringMesh.rotation.x = Math.PI / 3;
    meshGroup.add(ringMesh);

    // Inner glowing core ring for fiery blazing flame effect
    const innerRingGeo = new THREE.TorusGeometry(0.85, 0.02, 16, 48);
    const innerRingMat = new THREE.MeshBasicMaterial({
      color: 0xFF5500, // Blazing Orange-Red Flame
      transparent: true,
      opacity: 1.0,
      blending: THREE.AdditiveBlending,
    });
    const innerRingMesh = new THREE.Mesh(innerRingGeo, innerRingMat);
    innerRingMesh.rotation.x = Math.PI / 3;
    meshGroup.add(innerRingMesh);

    // Mouse parallax tracking
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    const handleMouseMove = (e: MouseEvent) => {
      const rect = container.getBoundingClientRect();
      mouseX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouseY = -((e.clientY - rect.top) / rect.height) * 2 + 1;
    };

    window.addEventListener('mousemove', handleMouseMove, { passive: true });

    // Resize handler
    const handleResize = () => {
      width = container.clientWidth || 320;
      height = container.clientHeight || 220;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    };

    window.addEventListener('resize', handleResize, { passive: true });

    // Animation Loop
    let animId: number;
    const clock = new THREE.Clock();

    const animate = () => {
      animId = requestAnimationFrame(animate);
      const elapsedTime = clock.getElapsedTime();

      // Rotation
      meshGroup.rotation.y = elapsedTime * 0.3;
      meshGroup.rotation.x = elapsedTime * 0.18;
      ringMesh.rotation.z = -elapsedTime * 0.5;
      innerRingMesh.rotation.z = -elapsedTime * 0.5;

      // Mouse lerp
      targetX += (mouseX * 0.5 - targetX) * 0.05;
      targetY += (mouseY * 0.5 - targetY) * 0.05;

      meshGroup.position.x = targetX * 0.5;
      meshGroup.position.y = targetY * 0.3;

      renderer.render(scene, camera);
    };

    animate();

    // Clean up on page transition
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animId);
      window.removeEventListener('mousemove', handleMouseMove);
      window.removeEventListener('resize', handleResize);
      renderer.dispose();
    }, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAbout3D);
  } else {
    initAbout3D();
  }
</script>

<style>
  .about-3d-wrapper {
    width: 100%;
    max-width: 320px;
    height: 200px;
    margin: 0 auto var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    pointer-events: none;
  }

  #about-3d-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
