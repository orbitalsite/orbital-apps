---
import { useTranslations, getLocalizedPath } from '@i18n/index';
import type { Lang } from '@i18n/languages';
import { siteConfig } from '@data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

// Helper to build URLs
const getUrl = (path: string) => `${base.replace(/\/$/, '')}${getLocalizedPath(lang, path)}`;

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-main">
      <div class="footer-col brand-col">
        <a href={getUrl('/')} class="footer-logo">
          <img src={`${base.replace(/\/$/, '')}/images/hlogo.png`} alt="ORBITAL Logo" />
          <span>{siteConfig.name || 'ORBITAL'}</span>
        </a>
        <p class="footer-desc">
          {t('footer.description') || 'Building next-generation digital solutions for a connected world.'}
        </p>
      </div>
      
      <div class="footer-col">
        <h3 class="footer-heading">{t('footer.products') || 'Products'}</h3>
        <ul class="footer-links">
          <li><a href={getUrl('/programs/clinic-system')}>برنامج العيادة الطبية</a></li>
        </ul>
      </div>
      
      <div class="footer-col">
        <h3 class="footer-heading">{t('footer.company') || 'Company'}</h3>
        <ul class="footer-links">
          <li><a href={getUrl('/about')}>{t('nav.about') || 'About Us'}</a></li>
          <li><a href={getUrl('/services')}>{t('nav.services') || 'Services'}</a></li>
        </ul>
      </div>
      
      <div class="footer-col">
        <h3 class="footer-heading">{t('nav.contact') || 'Contact'}</h3>
        <ul class="footer-links">
          <li><a href={getUrl('/contact')}>{t('nav.contact') || 'Contact Us'}</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-background-alt);
    border-block-start: 1px solid var(--color-border);
    color: var(--color-text);
    padding-block-start: var(--space-3xl, 4rem);
    padding-block-end: var(--space-xl, 2rem);
  }

  .footer-container {
    max-width: var(--container-max-width, 1200px);
    margin-inline: auto;
    padding-inline: var(--space-lg, 1.5rem);
  }

  .footer-main {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-2xl, 3rem);
    margin-block-end: var(--space-3xl, 4rem);
  }

  @media (min-width: 768px) {
    .footer-main {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-main {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-md, 1rem);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm, 0.5rem);
    text-decoration: none;
    color: var(--color-text);
    font-size: var(--font-size-xl, 1.25rem);
    font-weight: 700;
  }

  .footer-logo img {
    height: 32px;
    width: auto;
    object-fit: contain;
  }

  .footer-desc {
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 300px;
    margin: 0;
  }

  .footer-heading {
    font-size: var(--font-size-lg, 1.125rem);
    font-weight: 600;
    margin-block-start: 0;
    margin-block-end: var(--space-md, 1.25rem);
    color: var(--color-text);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm, 0.75rem);
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-links a:hover,
  .footer-links a:focus {
    color: var(--color-primary-light);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md, 1rem);
    padding-block-start: var(--space-xl, 2rem);
    border-block-start: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .copyright {
    color: var(--color-text-muted);
    margin: 0;
    font-size: var(--font-size-sm, 0.875rem);
  }

  .social-links {
    display: flex;
    gap: var(--space-md, 1rem);
  }

  .social-links a {
    color: var(--color-text-muted);
    transition: color 0.2s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .social-links a:hover,
  .social-links a:focus {
    color: var(--color-primary-light);
    transform: translateY(-2px);
  }
</style>
