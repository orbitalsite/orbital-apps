---
/**
 * ORBITAL — Theme Switcher
 * Dark/Light mode toggle button with sun/moon icons.
 */
import { useTranslations } from '@i18n/index';
import type { Lang } from '@i18n/languages';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button 
  id="theme-toggle" 
  class="theme-switcher" 
  aria-label={t('a11y.toggleTheme')}
  title={t('theme.toggle')}
  type="button"
>
  <!-- Sun Icon (shown in dark mode) -->
  <svg class="theme-switcher__icon theme-switcher__icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
  <!-- Moon Icon (shown in light mode) -->
  <svg class="theme-switcher__icon theme-switcher__icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  import { toggleTheme, getCurrentTheme } from '@scripts/theme';

  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    toggleTheme();
  });
</script>

<style>
  .theme-switcher {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    transition: background-color var(--transition-fast), color var(--transition-fast);
    cursor: pointer;
    position: relative;
  }

  .theme-switcher:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .theme-switcher__icon {
    position: absolute;
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  /* In light mode: show moon, hide sun */
  [data-theme="light"] .theme-switcher__icon--sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  [data-theme="light"] .theme-switcher__icon--moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  /* In dark mode: show sun, hide moon */
  [data-theme="dark"] .theme-switcher__icon--sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  [data-theme="dark"] .theme-switcher__icon--moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
</style>
