---
/**
 * ORBITAL — Contact 3D Canvas Component
 * Lightweight, high-performance 3D connectivity network mesh for Contact page
 */
---

<div class="contact-3d-wrapper">
  <canvas id="contact-3d-canvas"></canvas>
</div>

<script>
  import * as THREE from 'three';

  function initContact3D() {
    const canvas = document.getElementById('contact-3d-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const container = canvas.parentElement;
    if (!container) return;

    let width = container.clientWidth || 320;
    let height = container.clientHeight || 220;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.z = 4.6;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height);
    renderer.setClearColor(0x000000, 0);

    // Group for 3D mesh
    const meshGroup = new THREE.Group();
    scene.add(meshGroup);

    // 1. Satellite Body (Cylinder)
    const bodyGeo = new THREE.CylinderGeometry(0.15, 0.15, 0.8, 8);
    const bodyMat = new THREE.MeshBasicMaterial({ color: 0x4DC9F6, wireframe: true, transparent: true, opacity: 0.8 });
    const satBody = new THREE.Mesh(bodyGeo, bodyMat);
    meshGroup.add(satBody);

    // 2. Solar Panels (Thin Boxes)
    const panelGeo = new THREE.BoxGeometry(1.8, 0.02, 0.4);
    const panelEdges = new THREE.EdgesGeometry(panelGeo);
    const panelMat = new THREE.LineBasicMaterial({ color: 0x3B8BEB, transparent: true, opacity: 0.6 });
    const panels = new THREE.LineSegments(panelEdges, panelMat);
    meshGroup.add(panels);

    // Inner glowing nodes for panels
    const panelPointsMat = new THREE.PointsMaterial({ color: 0x5DA8F5, size: 0.05 });
    const panelPoints = new THREE.Points(panelGeo, panelPointsMat);
    meshGroup.add(panelPoints);

    // 3. Antenna Dish
    const dishGeo = new THREE.ConeGeometry(0.3, 0.2, 8, 1, true);
    const dishMat = new THREE.MeshBasicMaterial({ color: 0xFF2A4B, wireframe: true, transparent: true, opacity: 0.8 });
    const dish = new THREE.Mesh(dishGeo, dishMat);
    dish.position.y = 0.5;
    meshGroup.add(dish);

    // 4. Broadcasting Signal Rings
    const signalRings = new THREE.Group();
    const ringGeo = new THREE.TorusGeometry(0.3, 0.01, 8, 32);
    const ringMat = new THREE.MeshBasicMaterial({ color: 0xFF2A4B, transparent: true, opacity: 0.0, blending: THREE.AdditiveBlending });
    
    const ring1 = new THREE.Mesh(ringGeo, ringMat.clone());
    const ring2 = new THREE.Mesh(ringGeo, ringMat.clone());
    const ring3 = new THREE.Mesh(ringGeo, ringMat.clone());
    
    signalRings.add(ring1, ring2, ring3);
    signalRings.position.y = 0.6;
    signalRings.rotation.x = Math.PI / 2;
    meshGroup.add(signalRings);

    // Add rings to a global array for animation
    (window as any).signalRings = [ring1, ring2, ring3];

    // Mouse parallax tracking
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    const handleMouseMove = (e: MouseEvent) => {
      const rect = container.getBoundingClientRect();
      mouseX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouseY = -((e.clientY - rect.top) / rect.height) * 2 + 1;
    };

    window.addEventListener('mousemove', handleMouseMove, { passive: true });

    // Resize handler
    const handleResize = () => {
      width = container.clientWidth || 320;
      height = container.clientHeight || 220;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height);
    };

    window.addEventListener('resize', handleResize, { passive: true });

    // Animation Loop
    let animId: number;
    const clock = new THREE.Clock();

    const animate = () => {
      animId = requestAnimationFrame(animate);
      const elapsedTime = clock.getElapsedTime();

      // Rotation
      meshGroup.rotation.y = elapsedTime * 0.15;
      meshGroup.rotation.x = Math.sin(elapsedTime * 0.5) * 0.1; // Gentle wobble
      
      // Animate broadcasting rings
      const rings = (window as any).signalRings;
      if (rings && rings.length === 3) {
        rings.forEach((ring: THREE.Mesh, index: number) => {
          // Staggered animation
          const t = (elapsedTime * 1.5 + index * (2.0 / 3.0)) % 2.0;
          const scale = 1.0 + t * 4.0;
          ring.scale.set(scale, scale, scale);
          
          // Fade out as it expands
          const mat = ring.material as THREE.MeshBasicMaterial;
          mat.opacity = Math.max(0, 0.8 - t * 0.4);
        });
      }

      // Mouse lerp
      targetX += (mouseX * 0.5 - targetX) * 0.05;
      targetY += (mouseY * 0.5 - targetY) * 0.05;

      meshGroup.position.x = targetX * 0.5;
      meshGroup.position.y = targetY * 0.3;

      renderer.render(scene, camera);
    };

    animate();

    // Clean up on page transition
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animId);
      window.removeEventListener('mousemove', handleMouseMove);
      window.removeEventListener('resize', handleResize);
      renderer.dispose();
    }, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContact3D);
  } else {
    initContact3D();
  }
</script>

<style>
  .contact-3d-wrapper {
    width: 100%;
    max-width: 320px;
    height: 200px;
    margin: 0 auto var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    pointer-events: none;
  }

  #contact-3d-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
