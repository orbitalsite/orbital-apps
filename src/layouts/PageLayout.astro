---
/**
 * ORBITAL — Page Layout
 * Wraps pages with Navbar, main content, and Footer.
 */
import MainLayout from './MainLayout.astro';
import Navbar from '@components/navigation/Navbar.astro';
import type { Lang } from '@i18n/languages';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonicalPath?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
}

const props = Astro.props;
---

<MainLayout {...props}>
  <a href="#main-content" class="skip-to-content">
    {props.lang === 'ar' ? 'تخطي إلى المحتوى' : props.lang === 'fa' ? 'رفتن به محتوا' : 'Skip to content'}
  </a>
  
  <Navbar lang={props.lang} />
  
  <main id="main-content">
    <slot />
  </main>
  
  <!-- GSAP Scroll Animations — loaded after DOM -->
  <script>
    import { initScrollAnimations } from '@scripts/scroll-animations';
    import { initMobileMenu } from '@scripts/mobile-menu';
    
    document.addEventListener('DOMContentLoaded', () => {
      initMobileMenu();
      initScrollAnimations();
    });
  </script>
</MainLayout>
