---
import PageLayout from '@layouts/PageLayout.astro';
import { useTranslations, getLocalizedPath } from '@i18n/index';
import { languages, type Lang } from '@i18n/languages';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const articles = await getCollection('articles');
const sortedArticles = articles.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<PageLayout
  title={t('news.title') || 'الأخبار'}
  description={t('news.description') || 'آخر الأخبار والتحديثات التقنية'}
  lang={lang}
  canonicalPath="/news/"
>
  <div class="news-page">
    <section class="news-hero">
      <div class="container">
        <h1 data-animate="fade-up">{t('news.title') || 'الأخبار والمدونة الهندسية'}</h1>
        <div class="accent-line"></div>
        <p class="subtitle" data-animate="fade-up" data-delay="0.1">{t('news.description') || 'تابع أحدث التحديثات التقنية والمقالات الهندسية من فريق أوربيتال.'}</p>
      </div>
    </section>

    <section class="news-grid-section">
      <div class="container">
        <div class="news-grid">
          {sortedArticles.map((article, index) => {
            const a = article.data.translations[lang] || article.data.translations['en'];
            return (
              <a href={`${base.replace(/\/$/, '')}${getLocalizedPath(lang, `/news/${article.data.slug}/`)}`} class="article-card" data-animate="fade-up" data-delay={index * 0.1}>
                <div class="content">
                  <div class="meta">
                    <span class="category">{article.data.category}</span>
                    <span class="date">{article.data.publishedAt.toLocaleDateString(lang)}</span>
                  </div>
                  <h3>{a.title}</h3>
                  <p>{a.excerpt}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .news-page {
    background: var(--color-background);
    min-height: 100vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .news-hero {
    padding-top: calc(var(--navbar-height) + var(--space-8));
    padding-bottom: var(--space-12);
    text-align: center;
    background: linear-gradient(180deg, rgba(59, 139, 235, 0.05) 0%, transparent 100%);
  }
  
  .news-hero h1 {
    font-size: clamp(var(--font-size-3xl), 4vw, var(--font-size-5xl));
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .accent-line {
    width: 64px;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary-light), var(--color-glow));
    border-radius: var(--radius-full);
    margin: 0 auto var(--space-6);
  }
  
  .subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    max-width: 720px;
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  .news-grid-section {
    padding-top: var(--space-6);
    padding-bottom: var(--space-24);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .article-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .article-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-md), var(--shadow-glow);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .category {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    background: rgba(59, 139, 235, 0.1);
    color: var(--color-primary-light);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .date {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .article-card h3 {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .article-card p {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }
</style>
