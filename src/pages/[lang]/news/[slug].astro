---
import PageLayout from '@layouts/PageLayout.astro';
import { useTranslations, getLocalizedPath } from '@i18n/index';
import { languages, type Lang } from '@i18n/languages';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return Object.keys(languages).flatMap((lang) => 
    articles.map(article => ({
      params: { lang, slug: article.data.slug },
      props: { article }
    }))
  );
}

const { lang } = Astro.params as { lang: Lang };
const { article } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const a = article.data.translations[lang] || article.data.translations['en'];
---

<PageLayout
  title={`${a.title} | ${t('news.title') || 'الأخبار'}`}
  description={a.excerpt}
  lang={lang}
  canonicalPath={`/news/${article.data.slug}/`}
>
  <div class="news-detail-page">
    <div class="breadcrumb-container container">
      <div class="breadcrumb" data-animate="fade-right">
        <a href={`${base.replace(/\/$/, '')}${getLocalizedPath(lang, '/')}`}>{t('nav.home')}</a>
        <span class="separator">/</span>
        <a href={`${base.replace(/\/$/, '')}${getLocalizedPath(lang, '/news/')}`}>{t('news.title') || 'الأخبار'}</a>
        <span class="separator">/</span>
        <span class="current">{a.title}</span>
      </div>
    </div>

    <article class="article-detail">
      <header class="article-header">
        <div class="container container-sm">
          <div class="meta" data-animate="fade-up">
            <span class="category">{article.data.category}</span>
            <span class="date">{article.data.publishedAt.toLocaleDateString(lang)}</span>
          </div>
          <h1 data-animate="fade-up" data-delay="0.1">{a.title}</h1>
          <div class="author-info" data-animate="fade-up" data-delay="0.2">
            <span>بقلم <strong>{article.data.author}</strong></span>
          </div>
        </div>
      </header>

      <div class="article-content container container-sm" data-animate="fade-up">
        <div class="prose">
          <p>{a.content || a.excerpt}</p>
        </div>
      </div>
    </article>
  </div>
</PageLayout>

<style>
  .news-detail-page {
    background: var(--color-background);
    min-height: 100vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .breadcrumb-container {
    padding-top: calc(var(--navbar-height) + var(--space-8));
    padding-bottom: var(--space-4);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-primary-light);
  }

  .separator {
    color: var(--color-text-subtle);
  }

  .container-sm {
    max-width: 800px;
    margin: 0 auto;
  }

  .article-header {
    padding: var(--space-6) 0 var(--space-8);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .category {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    background: rgba(59, 139, 235, 0.1);
    color: var(--color-primary-light);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .date {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .article-header h1 {
    font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text);
    line-height: var(--line-height-tight);
    margin-bottom: var(--space-4);
  }

  .author-info {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .article-content {
    padding-bottom: var(--space-24);
  }

  .prose p {
    font-size: var(--font-size-lg);
    line-height: 1.8;
    color: var(--color-text);
  }
</style>
