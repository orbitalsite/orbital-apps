---
import PageLayout from '@layouts/PageLayout.astro';
import { useTranslations, getLocalizedPath } from '@i18n/index';
import { languages, type Lang } from '@i18n/languages';
import { getCollection } from 'astro:content';
import Programs3DCanvas from '@components/programs/Programs3DCanvas.astro';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLang = (lang || 'ar') as Lang;
const t = useTranslations(currentLang);
const products = await getCollection('products');
---

<PageLayout title={t('programs.title')} description={t('programs.description')} lang={currentLang}>
  <div class="programs-page">
    <!-- Hero Section (Safe clearance below fixed navbar) -->
    <section class="hero-section">
      <div class="container">
        <!-- 3D Geometric Mesh Canvas -->
        <Programs3DCanvas />
        <h1 class="hero-title">{t('programs.title')}</h1>
        <div class="accent-line"></div>
        <p class="hero-subtitle">{t('programs.description')}</p>
      </div>
    </section>

    <!-- Product Card Section -->
    <section class="products-section">
      <div class="container">
        {products.length === 0 ? (
          <div class="no-results">
            <p>{t('programs.noResults')}</p>
          </div>
        ) : (
          <div class="products-grid">
            {products.map((product) => {
              const trans = product.data.translations[currentLang] || product.data.translations['en'];
              return (
                <a 
                  href={`${base.replace(/\/$/, '')}${getLocalizedPath(currentLang, `/programs/${product.data.slug}/`)}`} 
                  class="product-card"
                >
                  <div class="card-header">
                    <div class="icon-placeholder medical-icon">
                      <!-- Medical Clinic Cross Icon -->
                      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="4" />
                        <path d="M12 7v10" />
                        <path d="M7 12h10" />
                      </svg>
                    </div>
                    <div class="card-arrow">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </div>
                  </div>

                  <div class="card-content">
                    <h3>{trans.name}</h3>
                    {trans.description && <p class="description">{trans.description}</p>}
                    <div class="meta">
                      {product.data.version && <span class="badge version">v{product.data.version}</span>}
                      {product.data.platforms && (
                        <span class="badge platform">{product.data.platforms.join(', ')}</span>
                      )}
                      {product.data.free ? (
                        <span class="badge free">{t('programs.free') || 'مجاني 100%'}</span>
                      ) : (
                        <span class="badge paid">Commercial</span>
                      )}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </section>
  </div>
</PageLayout>

<script>
  import { gsap } from 'gsap';

  function initProgramsAnimations() {
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (isReduced) return;

    const heroTitle = document.querySelector('.hero-title');
    const heroSubtitle = document.querySelector('.hero-subtitle');
    const productCards = document.querySelectorAll('.product-card');

    if (heroTitle) {
      gsap.set(heroTitle, { opacity: 0, y: 30 });
      gsap.to(heroTitle, { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' });
    }

    if (heroSubtitle) {
      gsap.set(heroSubtitle, { opacity: 0, y: 20 });
      gsap.to(heroSubtitle, { opacity: 1, y: 0, duration: 0.8, delay: 0.15, ease: 'power2.out' });
    }

    if (productCards.length > 0) {
      gsap.set(productCards, { opacity: 0, y: 35 });
      gsap.to(productCards, { opacity: 1, y: 0, duration: 0.9, delay: 0.25, stagger: 0.1, ease: 'power2.out' });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProgramsAnimations);
  } else {
    initProgramsAnimations();
  }
</script>

<style>
  .programs-page {
    padding-top: calc(var(--navbar-height) + var(--space-8));
    padding-bottom: var(--space-24);
    min-height: 100vh;
    background: var(--color-background);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .hero-section {
    padding: var(--space-4) 0 var(--space-10);
    text-align: center;
  }

  .hero-title {
    font-size: clamp(var(--font-size-3xl), 4vw, var(--font-size-5xl));
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    letter-spacing: var(--letter-spacing-tight);
  }

  .accent-line {
    width: 64px;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary-light), var(--color-glow));
    border-radius: var(--radius-full);
    margin: 0 auto var(--space-6);
  }

  .hero-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  .products-section {
    padding: var(--space-4) 0;
  }

  .products-grid {
    display: flex;
    justify-content: center;
    max-width: 720px;
    margin: 0 auto;
  }

  /* Product Card Styling */
  .product-card {
    width: 100%;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease, border-color 0.35s ease;
  }

  .product-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary-light), var(--color-glow));
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(59, 139, 235, 0.15), var(--shadow-md);
    border-color: var(--color-primary-light);
  }

  .product-card:hover::before {
    opacity: 1;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .icon-placeholder.medical-icon {
    width: 68px;
    height: 68px;
    background: rgba(59, 139, 235, 0.1);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(59, 139, 235, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-light);
    transition: all 0.3s ease;
  }

  .product-card:hover .icon-placeholder.medical-icon {
    border-color: var(--color-primary-light);
    background: rgba(59, 139, 235, 0.2);
  }

  .card-arrow {
    color: var(--color-text-muted);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  :global([dir="rtl"]) .card-arrow svg {
    transform: scaleX(-1);
  }

  .product-card:hover .card-arrow {
    color: var(--color-primary-light);
  }

  .card-content h3 {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }

  .card-content .description {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6);
    line-height: var(--line-height-relaxed);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: auto;
  }

  .badge {
    font-size: var(--font-size-xs);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    font-weight: var(--font-weight-semibold);
  }

  .badge.version {
    background: var(--color-background);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .badge.platform {
    background: rgba(59, 139, 235, 0.1);
    color: var(--color-primary-light);
  }

  .badge.free {
    background: rgba(16, 185, 129, 0.12);
    color: var(--color-success);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .badge.paid {
    background: rgba(245, 158, 11, 0.1);
    color: var(--color-warning);
  }

  .no-results {
    text-align: center;
    padding: var(--space-16) 0;
    color: var(--color-text-muted);
  }
</style>
