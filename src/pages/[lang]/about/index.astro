---
import PageLayout from '@layouts/PageLayout.astro';
import { useTranslations } from '@i18n/index';
import { languages, type Lang } from '@i18n/languages';
import About3DCanvas from '@components/about/About3DCanvas.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
const currentLang = (lang || 'ar') as Lang;
const t = useTranslations(currentLang);
---

<PageLayout
  title={t('about.title')}
  description={t('about.subtitle')}
  lang={currentLang}
  canonicalPath="/about/"
>
  <div class="about-page">
    <!-- Hero Section (Safe clearance below 110px navbar) -->
    <section class="about-hero">
      <div class="container">
        <!-- Lightweight 3D Canvas -->
        <About3DCanvas />
        <div class="hero-badge">
          <span>ORBITAL</span>
        </div>
        <h1 class="hero-title">{t('about.title')}</h1>
        <div class="accent-line"></div>
        <p class="hero-quote">
          "{t('about.whoWeAre.tagline')}"
        </p>
      </div>
    </section>

    <!-- Who We Are & Story Section -->
    <section class="story-section">
      <div class="container">
        <div class="grid-two">
          <!-- Who We Are -->
          <div class="info-card">
            <div class="card-header">
              <div class="icon-box">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              </div>
              <h2>{t('about.whoWeAre.title')}</h2>
            </div>
            <p class="paragraph">{t('about.whoWeAre.p1')}</p>
            <p class="paragraph">{t('about.whoWeAre.p2')}</p>
          </div>

          <!-- Our Story -->
          <div class="info-card highlight-card">
            <div class="card-header">
              <div class="icon-box">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20h9" />
                  <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                </svg>
              </div>
              <h2>{t('about.story.title')}</h2>
            </div>
            <p class="paragraph">{t('about.story.p1')}</p>
            <p class="paragraph bold-text">{t('about.story.p2')}</p>
            <p class="paragraph">{t('about.story.p3')}</p>
            <p class="paragraph">{t('about.story.p4')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission & Vision Section -->
    <section class="mission-vision-section">
      <div class="container">
        <div class="grid-two">
          <!-- Mission -->
          <div class="mv-card mission-card">
            <div class="mv-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <circle cx="12" cy="12" r="6" />
                <circle cx="12" cy="12" r="2" />
              </svg>
            </div>
            <h2>{t('about.mission.title')}</h2>
            <p class="paragraph mv-lead">{t('about.mission.p1')}</p>
            <p class="paragraph">{t('about.mission.p2')}</p>
          </div>

          <!-- Vision -->
          <div class="mv-card vision-card">
            <div class="mv-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </div>
            <h2>{t('about.vision.title')}</h2>
            <p class="paragraph mv-lead">{t('about.vision.p1')}</p>
            <p class="paragraph">{t('about.vision.p2')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- What Makes Us Unique Section (4 pillars) -->
    <section class="features-section">
      <div class="container">
        <div class="section-title-block">
          <h2>{t('about.features.title')}</h2>
          <div class="accent-line"></div>
        </div>

        <div class="features-grid">
          <!-- Ecosystem -->
          <div class="feature-card">
            <div class="feat-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="8" height="8" rx="2" />
                <rect x="14" y="2" width="8" height="8" rx="2" />
                <rect x="2" y="14" width="8" height="8" rx="2" />
                <rect x="14" y="14" width="8" height="8" rx="2" />
              </svg>
            </div>
            <h3>{t('about.features.items.ecosystem.title')}</h3>
            <p class="paragraph">{t('about.features.items.ecosystem.description')}</p>
          </div>

          <!-- Tailored -->
          <div class="feature-card">
            <div class="feat-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
            </div>
            <h3>{t('about.features.items.tailored.title')}</h3>
            <p class="paragraph">{t('about.features.items.tailored.description')}</p>
          </div>

          <!-- Accessibility -->
          <div class="feature-card">
            <div class="feat-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
              </svg>
            </div>
            <h3>{t('about.features.items.accessibility.title')}</h3>
            <p class="paragraph">{t('about.features.items.accessibility.description')}</p>
          </div>

          <!-- Support -->
          <div class="feature-card">
            <div class="feat-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
              </svg>
            </div>
            <h3>{t('about.features.items.support.title')}</h3>
            <p class="paragraph">{t('about.features.items.support.description')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Values Section -->
    <section class="values-section">
      <div class="container">
        <div class="section-title-block">
          <h2>{t('about.values.title')}</h2>
          <div class="accent-line"></div>
        </div>

        <div class="values-grid">
          <!-- Transparency -->
          <div class="value-card">
            <div class="val-num">01</div>
            <h3>{t('about.values.items.transparency.title')}</h3>
            <p class="paragraph">{t('about.values.items.transparency.description')}</p>
          </div>

          <!-- Innovation -->
          <div class="value-card">
            <div class="val-num">02</div>
            <h3>{t('about.values.items.innovation.title')}</h3>
            <p class="paragraph">{t('about.values.items.innovation.description')}</p>
          </div>

          <!-- Quality -->
          <div class="value-card">
            <div class="val-num">03</div>
            <h3>{t('about.values.items.quality.title')}</h3>
            <p class="paragraph">{t('about.values.items.quality.description')}</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<script>
  import { gsap } from 'gsap';

  function initAboutAnimations() {
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (isReduced) return;

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    // Hero Badge & Title entrance timeline
    tl.from('.hero-badge', { scale: 0.8, opacity: 0, duration: 0.7, delay: 0.2 })
      .from('.hero-title', { y: 40, opacity: 0, duration: 0.9 }, '-=0.4')
      .from('.about-hero .accent-line', { scaleX: 0, opacity: 0, duration: 0.8, transformOrigin: 'center' }, '-=0.5')
      .from('.hero-quote', { y: 30, opacity: 0, duration: 0.9 }, '-=0.4');

    // Staggered Cards Entrance
    const cards = document.querySelectorAll('.info-card, .mv-card, .feature-card, .value-card');
    if (cards.length > 0) {
      gsap.from(cards, {
        opacity: 0,
        y: 50,
        duration: 1.0,
        stagger: 0.12,
        delay: 0.4,
        ease: 'power3.out',
      });
    }

    // Interactive Icon Hover Micro-animations
    document.querySelectorAll('.icon-box, .mv-icon, .feat-icon').forEach((icon) => {
      icon.addEventListener('mouseenter', () => {
        gsap.to(icon, { scale: 1.12, rotation: 6, duration: 0.3, ease: 'back.out(1.7)' });
      });
      icon.addEventListener('mouseleave', () => {
        gsap.to(icon, { scale: 1, rotation: 0, duration: 0.3, ease: 'power2.out' });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutAnimations);
  } else {
    initAboutAnimations();
  }
</script>

<style>
  .about-page {
    background: var(--color-background);
    min-height: 100vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  /* Paragraph spacing */
  .paragraph {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--space-5);
  }

  .paragraph:last-child {
    margin-bottom: 0;
  }

  /* ── Hero Section (Cleared 140px below fixed navbar) ── */
  .about-hero {
    padding-top: calc(var(--navbar-height) + var(--space-8));
    padding-bottom: var(--space-16);
    text-align: center;
    background: linear-gradient(180deg, rgba(59, 139, 235, 0.05) 0%, transparent 100%);
  }

  .hero-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-4);
    background: rgba(59, 139, 235, 0.1);
    border: 1px solid rgba(59, 139, 235, 0.25);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-extrabold);
    letter-spacing: var(--letter-spacing-widest);
    color: var(--color-primary-light);
    margin-bottom: var(--space-4);
  }

  .hero-title {
    font-size: clamp(var(--font-size-3xl), 5vw, var(--font-size-5xl));
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    letter-spacing: var(--letter-spacing-tight);
  }

  .accent-line {
    width: 64px;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary-light), var(--color-glow));
    border-radius: var(--radius-full);
    margin: 0 auto var(--space-6);
  }

  .hero-quote {
    font-size: clamp(var(--font-size-lg), 2.5vw, var(--font-size-2xl));
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary-light);
    max-width: 820px;
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  /* ── Story Section ── */
  .story-section {
    padding-block: var(--space-12);
  }

  .grid-two {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 900px) {
    .grid-two {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .info-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .info-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md), var(--shadow-glow);
    border-color: var(--color-primary-light);
  }

  .highlight-card {
    background: linear-gradient(135deg, var(--color-surface) 0%, rgba(59, 139, 235, 0.04) 100%);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .icon-box {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    background: rgba(59, 139, 235, 0.1);
    border: 1px solid rgba(59, 139, 235, 0.2);
    color: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
  }

  .card-header h2 {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: 0;
  }

  .bold-text {
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-light) !important;
  }

  /* ── Mission & Vision ── */
  .mission-vision-section {
    padding-block: var(--space-12);
  }

  .mv-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .mv-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
  }

  .mission-card::before {
    background: linear-gradient(90deg, #3B8BEB, #4DC9F6);
  }

  .vision-card::before {
    background: linear-gradient(90deg, #10B981, #3B8BEB);
  }

  .mv-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary-light);
  }

  .mv-icon {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-lg);
    background: rgba(59, 139, 235, 0.1);
    color: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
    cursor: pointer;
  }

  .mv-card h2 {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-4);
  }

  .mv-lead {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text) !important;
  }

  /* ── Features Grid (4 items) ── */
  .features-section {
    padding-block: var(--space-12);
  }

  .section-title-block {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .section-title-block h2 {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-md), var(--shadow-glow);
  }

  .feat-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    background: rgba(59, 139, 235, 0.1);
    color: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
    cursor: pointer;
  }

  .feature-card h3 {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }

  /* ── Values Grid ── */
  .values-section {
    padding-block: var(--space-12) var(--space-24);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .values-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .value-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .value-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary-light);
  }

  .val-num {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-primary-light);
    opacity: 0.6;
    letter-spacing: var(--letter-spacing-widest);
    margin-bottom: var(--space-2);
  }

  .value-card h3 {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }
</style>
