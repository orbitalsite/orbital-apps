---
import PageLayout from '@layouts/PageLayout.astro';
import { useTranslations, getLocalizedPath } from '@i18n/index';
import { languages, type Lang } from '@i18n/languages';
import { services } from '@data/services';
import Services3DCanvas from '@components/services/Services3DCanvas.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
---

<PageLayout
  title={t('services.title')}
  description={t('services.description')}
  lang={lang}
  canonicalPath="/services/"
>
  <div class="services-page-wrapper">
    <!-- Hero Section with Lightweight 3D Canvas & Clearance -->
    <section class="services-hero">
      <div class="container">
        <!-- Lightweight Interactive 3D Cybernetic Mesh -->
        <Services3DCanvas />
        <h1 class="hero-title">{t('services.title')}</h1>
        <div class="hero-accent-line"></div>
        <p class="subtitle">{t('services.description')}</p>
      </div>
    </section>

    <!-- Services Grid Section -->
    <section class="services-grid-section">
      <div class="container">
        <div class="services-grid">
          {services.map((service, index) => (
            <div class="service-card" data-animate="fade-up" data-delay={index * 0.1}>
              <div class="card-icon-box">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="32" height="32">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={service.iconPath} />
                </svg>
              </div>
              <h2 class="card-title">{t(`services.items.${service.translationKey}.title`)}</h2>
              <p class="card-text">{t(`services.items.${service.translationKey}.description`)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .services-page-wrapper {
    background: var(--color-background);
    min-height: 100vh;
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding-inline: var(--space-6);
  }

  /* Hero Section safely separated from 110px fixed navbar */
  .services-hero {
    padding-top: calc(var(--navbar-height) + var(--space-8));
    padding-bottom: var(--space-12);
    text-align: center;
    background: linear-gradient(180deg, rgba(59, 139, 235, 0.04) 0%, transparent 100%);
  }
  
  .hero-title {
    font-size: clamp(var(--font-size-3xl), 4vw, var(--font-size-5xl));
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    letter-spacing: var(--letter-spacing-tight);
  }

  .hero-accent-line {
    width: 64px;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary-light), var(--color-glow));
    border-radius: var(--radius-full);
    margin: 0 auto var(--space-6);
  }
  
  .subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    max-width: 760px;
    margin: 0 auto;
    line-height: var(--line-height-relaxed);
  }

  .services-grid-section {
    padding-top: var(--space-6);
    padding-bottom: var(--space-24);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Enhanced Service Cards */
  .service-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease, border-color 0.35s ease;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary-light), var(--color-glow));
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 36px rgba(59, 139, 235, 0.15), var(--shadow-md);
    border-color: var(--color-primary-light);
  }

  .service-card:hover::before {
    opacity: 1;
  }

  .card-icon-box {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-lg);
    background: rgba(59, 139, 235, 0.1);
    border: 1px solid rgba(59, 139, 235, 0.2);
    color: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .service-card:hover .card-icon-box {
    background: rgba(59, 139, 235, 0.2);
    border-color: var(--color-primary-light);
  }

  .card-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-3);
    color: var(--color-text);
    line-height: var(--line-height-snug);
  }

  .card-text {
    color: var(--color-text-muted);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }
</style>
